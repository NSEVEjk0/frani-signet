# Frani Signet — configuration
# Copy to .env and adjust. All values have testnet2 defaults.

# Network. Must be testnet2. Do not point this at mainnet.
SIGNET_NETWORK=testnet2

# Where the wallet keys and state live on disk.
SIGNET_DATA_DIR=./wallet-data

# testnet2 wallet-api base URL.
SIGNET_WALLET_API=https://wallet-api.unicity.network

# Public testnet2 oracle key (not a secret). Override for other environments.
SIGNET_ORACLE_KEY=sk_ddc3cfcc001e4a28ac3fad7407f99590

# Stable per-machine device id for the wallet-api session.
SIGNET_DEVICE_ID=frani-signet-1

# Optional @nametag to register on first run (leave blank to skip).
SIGNET_NAMETAG=

# Optional paid "official certificate" price in whole UCT. 0 disables it.
SIGNET_CERT_PRICE_UCT=0

# Directory where issued receipts are archived.
SIGNET_RECEIPTS_DIR=./receipts
